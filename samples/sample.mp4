                if (!turnstileIsRequired()) {
                    return Promise.resolve('');
                }
                var siteKey = turnstileSiteKey();
                if (!siteKey) {
                    return Promise.resolve('');
                }
                placeTurnstileHostAbove(nearBtn || turnstileMountedNear || document.querySelector('.btn-download-with-progress'));
                return new Promise(function (resolve, reject) {
                    ensureTurnstileWidget(function (err) {
                        if (err) {
                            reject(err instanceof Error ? err : new Error(String(err)));
                            return;
                        }
                        resolve(peekTurnstileToken());
                    });
                });
            }
            function peekTurnstileToken() {
                if (turnstileLastToken) return turnstileLastToken;
                try {
                    if (turnstileWidgetId !== null && window.turnstile && typeof window.turnstile.getResponse === 'function') {
                        var existing = window.turnstile.getResponse(turnstileWidgetId);
                        if (existing) {
                            turnstileLastToken = existing;
                            return existing;
                        }
                    }
                } catch (e) {}
                return '';
            }
            function showDownloadPageAlert(msg) {
                var el = document.getElementById('download-page-alert');
                if (!el) return;
                var text = el.querySelector('.download-page-alert__text');
                if (text) text.textContent = msg || '';
                el.removeAttribute('hidden');
                try {
                    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } catch (e) {}
            }
            function hideDownloadPageAlert() {
                var el = document.getElementById('download-page-alert');
                if (el) el.setAttribute('hidden', '');
            }
            function showTurnstileWarning(wrap, bar, textEl, msg) {
                hideDownloadPageAlert();
                wrap.removeAttribute('hidden');
                wrap.classList.remove('download-progress-wrap--error');
                wrap.classList.add('download-progress-wrap--warn');
                if (bar) bar.style.display = 'none';
                textEl.textContent = msg;
            }
            function probeTurnstileRequired(url, csrf) {
                if (!turnstileSiteKey()) {
                    return Promise.resolve(false);
                }
                var fd = new FormData();
                fd.append('_token', csrf);
                return fetch(url, {
                    method: 'POST',
                    body: fd,
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-Turnstile-Probe': '1',
                    },
                }).then(function (res) {
                    syncTurnstileRequiredFromResponse(res);
                    return res.json().catch(function () { return {}; }).then(function (data) {
                        if (data && typeof data.required === 'boolean') {
                            setTurnstileRequired(data.required);
                        }
                        return turnstileIsRequired();
                    });
                }).catch(function () {
                    return turnstileIsRequired();
                });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bootDownloadAlerts);
            } else {
                bootDownloadAlerts();
            }
            function bootDownloadAlerts() {
                var meta = document.querySelector('meta[name="turnstile-required"]');
                if (meta) {
                    setTurnstileRequired(meta.getAttribute('content') === '1');
                    if (!turnstileIsRequired()) {
                        hideTurnstileHost();
                    }
                }
                            }

            document.body.addEventListener('click', async function (e) {
                var copyBtn = e.target.closest('.btn-copy-url');
                if (copyBtn) {
                    e.preventDefault();
                    var url = copyBtn.getAttribute('data-copy-url');
                    if (url) {
                        var label = copyBtn.getAttribute('data-copy-label') || 'Copy URL';
                        var copied = copyBtn.getAttribute('data-copied-label') || 'Copied!';
                        navigator.clipboard.writeText(url).then(function () {
                            copyBtn.textContent = copied;
                            copyBtn.disabled = true;
                            setTimeout(function () {
                                copyBtn.textContent = label;
                                copyBtn.disabled = false;
                            }, 2000);
                        });
                    }
                    return;
                }
                var btn = e.target.closest('.btn-download-with-progress');
                if (!btn) return;
                e.preventDefault();
                e.stopPropagation();
                var filename = btn.getAttribute('data-download-filename') || 'download';
                var livewireTab = btn.getAttribute('data-livewire-download');
                var dl = null;
                var comp = null;
                if (livewireTab && window.Livewire) {
                    var root = btn.closest('[wire\\:id]');
                    if (root) {
                        var id = root.getAttribute('wire:id');
                        if (id) {
                            try {
                                comp = Livewire.find(id);
                                if (comp && typeof comp.call === 'function') {
                                    var tabCap = livewireTab.charAt(0).toUpperCase() + livewireTab.slice(1);
                                    dl = await comp.call('getWebDownloadPayload', livewireTab);
                                    filename = await comp.call('getExampleFilename' + tabCap);
                                }
                            } catch (err) { console.error(err); }
                        }
                    }
                }
                if (!dl || !dl.url) {
                    var dataUrl = btn.getAttribute('data-download-url');
                    if (dataUrl) {
                        var fields = {};
                        try { fields = JSON.parse(btn.getAttribute('data-download-fields') || '{}'); } catch (err) { fields = {}; }
                        dl = { url: dataUrl, fields: fields };
                        filename = btn.getAttribute('data-download-filename') || filename;
                    }
                }
                if (!dl || !dl.url) return;
                var url = dl.url;
                var fields = dl.fields || {};
                var csrfMeta = document.querySelector('meta[name="csrf-token"]');
                var csrf = csrfMeta ? csrfMeta.getAttribute('content') : '';
                var card = btn.closest('.quick-dl-card') || btn.closest('.card') || btn.closest('.landing-hero__inner') || btn.closest('.landing-hero');
                var wrap = card ? card.querySelector('.download-progress-wrap') : null;
                if (!wrap) return;
                var bar = wrap.querySelector('.download-progress-bar');
                var fill = wrap.querySelector('.download-progress-fill');
                var textEl = wrap.querySelector('.download-progress-text');
                if (!fill || !textEl) return;
                var fileSizeTooLarge = "File size is too large.";
                var turnstileError = "Security check failed. Please reload the page and try again.";
                var turnstileWaitMsg = "Please confirm the security check first.";
                var turnstileToken = '';
                try {
                    await probeTurnstileRequired(url, csrf);
                    if (turnstileIsRequired()) {
                        turnstileToken = peekTurnstileToken();
                        if (!turnstileToken) {
                            showTurnstileNear(btn);
                            showTurnstileWarning(wrap, bar, textEl, turnstileWaitMsg);
                            return;
                        }
                    } else {
                        turnstileToken = '';
                        wrap.classList.remove('download-progress-wrap--warn');
                    }
                } catch (err) {
                    wrap.removeAttribute('hidden');
                    wrap.classList.remove('download-progress-wrap--warn');
                    wrap.classList.add('download-progress-wrap--error');
                    if (bar) bar.style.display = 'none';
                    textEl.textContent = (err && err.message) ? err.message : turnstileError;
                    setTimeout(function () { wrap.setAttribute('hidden', ''); wrap.classList.remove('download-progress-wrap--error'); if (bar) bar.style.display = ''; }, 4000);
                    return;
                }
                wrap.classList.remove('download-progress-wrap--warn');
                if (btn.hasAttribute('data-file-size-bytes')) {
                    var requestedBytes = parseInt(btn.getAttribute('data-file-size-bytes') || '0', 10);
                    var maxFileBytes = parseInt(btn.getAttribute('data-max-file-size-bytes') || '0', 10);
                    if (maxFileBytes > 0 && requestedBytes > maxFileBytes) {
                        wrap.removeAttribute('hidden');
                        wrap.classList.add('download-progress-wrap--error');
                        if (bar) bar.style.display = 'none';
                        textEl.textContent = fileSizeTooLarge;
                        return;
                    }
                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = url;
                    form.target = '_self';
                    var t0 = document.createElement('input');
                    t0.type = 'hidden';
                    t0.name = '_token';
                    t0.value = csrf;
                    form.appendChild(t0);
                    if (turnstileToken) {
                        var t1 = document.createElement('input');
                        t1.type = 'hidden';
                        t1.name = 'cf-turnstile-response';
                        t1.value = turnstileToken;
                        form.appendChild(t1);
                    }
                    Object.keys(fields).forEach(function (k) {
                        var inp = document.createElement('input');
                        inp.type = 'hidden';
                        inp.name = k;
                        inp.value = fields[k];
                        form.appendChild(inp);
                    });
                    document.body.appendChild(form);
                    trackFileGeneration({
                        filename: filename,
                        fields: fields,
                        bytes: requestedBytes,
                        kind: livewireTab || fields.type || fields.format || fields.ext
                    });
                    form.submit();
                    form.remove();
                    if (turnstileToken) {
                        clearTurnstileToken();
                    }
                    return;
                }
                btn.disabled = true;
                btn.classList.add('opacity-60');
                hideDownloadPageAlert();
                document.querySelectorAll('.download-progress-wrap').forEach(function (w) { w.setAttribute('hidden', ''); w.classList.remove('download-progress-wrap--error'); w.classList.remove('download-progress-wrap--warn'); });
                wrap.removeAttribute('hidden');
                wrap.classList.remove('download-progress-wrap--error');
                wrap.classList.remove('download-progress-wrap--warn');
                if (bar) bar.style.display = '';
                fill.style.width = '0%';
                textEl.textContent = '0 %';
                var fallbackError = "Download failed";
                var rateLimitError = "Too many downloads. Please wait a minute and try again.";
                var serverErrorLabel = "Server error";

                function runFetchDownload(token) {
                    var fd = new FormData();
                    fd.append('_token', csrf);
                    if (token) {
                        fd.append('cf-turnstile-response', token);
                    }
                    Object.keys(fields).forEach(function (k) {
                        fd.append(k, fields[k]);
                    });
                    return fetch(url, {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'application/json, application/pdf, */*',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                    }).then(function (res) {
                        syncTurnstileRequiredFromResponse(res);
                        if (turnstileIsRequired()) {
                            showTurnstileNear(btn);
                        }
                        if (!res.ok) {
                            return res.text().then(function (text) {
                                var msg = fallbackError;
                                var needsTurnstileRetry = false;
                                if (res.status === 429) {
                                    msg = rateLimitError;
                                    try {
                                        var rateData = text ? JSON.parse(text) : null;
                                        if (rateData && typeof rateData.message === 'string' && rateData.message.trim() !== '') {
                                            msg = rateData.message;
                                        }
                                    } catch (e) {}
                                    var rateErr = new Error(msg);
                                    rateErr.rateLimited = true;
                                    throw rateErr;
                                }
                                if (res.status === 403) {
                                    msg = turnstileError;
                                    try {
                                        var denyData = text ? JSON.parse(text) : null;
                                        if (denyData && typeof denyData.message === 'string' && denyData.message.trim() !== '') {
                                            msg = denyData.message;
                                        }
                                        if (denyData && denyData.turnstile_required) {
                                            needsTurnstileRetry = true;
                                            setTurnstileRequired(true);
                                            showTurnstileNear(btn);
                                            msg = turnstileWaitMsg;
                                        }
                                    } catch (e) {}
                                    if (needsTurnstileRetry) {
                                        var warnErr = new Error(msg);
                                        warnErr.turnstileWarn = true;
                                        throw warnErr;
                                    }
                                    throw new Error(msg);
                                }
                                try {
                                    var data = text ? JSON.parse(text) : null;
                                    if (data && data.errors && typeof data.errors === 'object') {
                                        var firstField = Object.keys(data.errors)[0];
                                        var firstMessages = firstField ? data.errors[firstField] : null;
                                        var firstMessage = Array.isArray(firstMessages) ? firstMessages[0] : firstMessages;
                                        if (typeof firstMessage === 'string' && firstMessage.trim() !== '') {
                                            msg = firstMessage;
                                        } else if (typeof data.message === 'string' && data.message.trim() !== '') {
                                            msg = data.message;
                                        }
                                    } else if (data && typeof data.error === 'string') {
                                        msg = data.error;
                                        if (msg.toLowerCase().indexOf('exceeds maximum') !== -1 || msg.toLowerCase().indexOf('file size') !== -1) {
                                            msg = fileSizeTooLarge;
                                        }
                                    } else if (data && typeof data.message === 'string' && data.message.trim() !== '') {
                                        msg = data.message;
                                    } else if (text && text.length > 0) {
                                        var short = text.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 120);
                                        if (short.length > 0) {
                                            msg = short;
                                        } else {
                                            msg = serverErrorLabel + ' (' + res.status + ')';
                                        }
                                    } else {
                                        msg = serverErrorLabel + ' (' + res.status + ')';
                                    }
                                } catch (e) {
                                    msg = serverErrorLabel + ' (' + res.status + ')';
                                }
                                throw new Error(msg);
                            });
                        }
                        var contentType = res.headers.get('Content-Type') || 'application/octet-stream';
                        var total = parseInt(res.headers.get('Content-Length') || '0', 10);
                        var reader = res.body.getReader();
                        var chunks = [];
                        var received = 0;
                        function pump() {
                            return reader.read().then(function (result) {
                                if (result.done) return { chunks: chunks, contentType: contentType };
                                chunks.push(result.value);
                                received += result.value.length;
                                if (total > 0) {
                                    var pct = Math.min(99, Math.round(received / total * 100));
                                    fill.style.width = pct + '%';
                                    textEl.textContent = pct + ' %';
                                } else {
                                    var mb = (received / 1048576).toFixed(1);
                                    textEl.textContent = mb + ' MB';
                                }
                                return pump();
                            });
                        }
                        return pump();
                    });
                }

                runFetchDownload(turnstileToken).then(function (result) {
                    var chunks = result.chunks;
                    var contentType = result.contentType || 'application/octet-stream';
                    fill.style.width = '100%';
                    textEl.textContent = '100 %';
                    var blob = new Blob(chunks, { type: contentType });
                    trackFileGeneration({
                        filename: filename,
                        fields: fields,
                        bytes: blob.size,
                        kind: livewireTab || fields.type || fields.format || fields.ext
                    });
                    var a = document.createElement('a');
                    var blobUrl = URL.createObjectURL(blob);
                    a.href = blobUrl;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    setTimeout(function () { URL.revokeObjectURL(blobUrl); wrap.setAttribute('hidden', ''); }, 1000);
                }).catch(function (err) {
                    console.error('Download error:', err);
                    if (bar) bar.style.display = 'none';
                    if (err && err.rateLimited) {
                        wrap.setAttribute('hidden', '');
                        wrap.classList.remove('download-progress-wrap--error');
                        wrap.classList.remove('download-progress-wrap--warn');
                        showDownloadPageAlert(err.message || rateLimitError);
                        return;
                    }
                    if (err && err.turnstileWarn) {
                        showTurnstileWarning(wrap, bar, textEl, err.message || turnstileWaitMsg);
                        return;
                    }
                    wrap.classList.remove('download-progress-wrap--warn');
                    wrap.classList.add('download-progress-wrap--error');
                    textEl.textContent = err.message || fallbackError;
                    setTimeout(function () { wrap.setAttribute('hidden', ''); wrap.classList.remove('download-progress-wrap--error'); if (bar) bar.style.display = ''; }, 4000);
                }).finally(function () {
                    btn.disabled = false;
                    btn.classList.remove('opacity-60');
                });
            });

            (function () {
                var box = document.getElementById('lang-hint');
                if (!box) return;
                try {
                    if (localStorage.getItem('lang_hint_dismissed') === '1') return;
                } catch (e) {}
                var hints = {};
                try { hints = JSON.parse(box.getAttribute('data-hints') || '{}'); } catch (e) { return; }
                var current = box.getAttribute('data-current');
                var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']);
                var target = null;
                for (var i = 0; i < langs.length; i++) {
                    var code = String(langs[i] || '').toLowerCase().split('-')[0];
                    if (hints[code]) { target = code; break; }
                }
                if (!target || target === current) return;
                var link = box.querySelector('.lang-hint__link');
                link.textContent = hints[target].text;
                link.setAttribute('href', hints[target].url);
                link.setAttribute('hreflang', target);
                box.removeAttribute('hidden');
                box.querySelector('.lang-hint__close').addEventListener('click', function () {
                    box.setAttribute('hidden', '');
                    try { localStorage.setItem('lang_hint_dismissed', '1'); } catch (e) {}
                });
            })();

            document.querySelectorAll('.theme-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var el = document.documentElement;
                    var isDark = el.classList.contains('dark');
                    if (isDark) {
                        el.classList.remove('dark');
                        try { localStorage.setItem('flux.appearance', 'light'); } catch (e) {}
                    } else {
                        el.classList.add('dark');
                        try { localStorage.setItem('flux.appearance', 'dark'); } catch (e) {}
                    }
                    var menu = document.getElementById('header-menu');
                    if (menu && menu.getAttribute('hidden') !== 'true') {
                        menu.setAttribute('hidden', '');
                        document.getElementById('header-menu-backdrop').setAttribute('hidden', '');
                        document.getElementById('hamburger').setAttribute('aria-expanded', 'false');
                    }
                });
            });

            (function () {
                var hamburger = document.getElementById('hamburger');
                var menu = document.getElementById('header-menu');
                var backdrop = document.getElementById('header-menu-backdrop');
                if (!hamburger || !menu || !backdrop) return;
                function openMenu() {
                    menu.removeAttribute('hidden');
                    backdrop.removeAttribute('hidden');
                    hamburger.setAttribute('aria-expanded', 'true');
                }
                function closeMenu() {
                    menu.setAttribute('hidden', '');
                    backdrop.setAttribute('hidden', '');
                    hamburger.setAttribute('aria-expanded', 'false');
                }
                hamburger.addEventListener('click', function () {
                    if (menu.hasAttribute('hidden')) openMenu(); else closeMenu();
                });
                backdrop.addEventListener('click', closeMenu);
            })();
        </script>
    </body>
</html>
