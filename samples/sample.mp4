        <script>
            function trackFileGeneration(opts) {
                opts = opts || {};
                var fields = opts.fields || {};
                var filename = opts.filename || 'download';
                var bytes = parseInt(opts.bytes, 10) || 0;
                var kind = String(opts.kind || fields.type || fields.format || fields.ext || 'file').toLowerCase();
                var label = filename;
                if (fields.seconds && fields.width && fields.height) {
                    label = fields.seconds + 's ' + fields.width + 'x' + fields.height + ' ' + kind;
                } else if (fields.size && fields.width && fields.height) {
                    label = fields.size + ' ' + fields.width + 'x' + fields.height + ' ' + kind;
                } else if (fields.size) {
                    label = fields.size + ' ' + kind;
                } else if (fields.pages) {
                    label = fields.pages + ' pages pdf';
                } else if (fields.rows) {
                    label = fields.rows + ' rows csv';
                } else if (fields.width && fields.height) {
                    label = fields.width + 'x' + fields.height + ' ' + kind;
                } else if (fields.chars) {
                    label = fields.chars + ' chars';
                } else if (fields.count) {
                    label = fields.count + ' records json';
                }
                var ext = '';
                var extMatch = filename.match(/\.([a-z0-9]+)$/i);
                if (extMatch) ext = extMatch[1].toLowerCase();

                var paq = window._paq = window._paq || [];
                if (bytes > 0) {
                    paq.push(['trackEvent', 'Generate', kind, label, bytes]);
                } else {
                    paq.push(['trackEvent', 'Generate', kind, label]);
                }

                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                    event: 'file_download',
                    file_name: filename,
                    file_extension: ext,
                    file_size: bytes > 0 ? bytes : undefined,
                    file_type: kind,
                    generation_label: label
                });
            }

            var turnstileWidgetId = null;
            var turnstileTokenWaiters = null;
            var turnstileLastToken = '';
            var turnstileMountedNear = null;
            function turnstileSiteKey() {
                var meta = document.querySelector('meta[name="turnstile-site-key"]');
                return meta ? (meta.getAttribute('content') || '') : '';
            }
            function turnstileCookieRequired() {
                return /(?:^|;\s*)dummyfiles_turnstile=1(?:;|$)/.test(document.cookie || '');
            }
            function turnstileIsRequired() {
                var meta = document.querySelector('meta[name="turnstile-required"]');
                var metaRequired = meta && meta.getAttribute('content') === '1';
                var metaFree = meta && meta.getAttribute('content') === '0';
                if (metaRequired || turnstileCookieRequired()) return true;
                if (metaFree) return false;
                return false;
            }
            function setTurnstileRequired(required) {
                var meta = document.querySelector('meta[name="turnstile-required"]');
                if (!meta && turnstileSiteKey()) {
                    meta = document.createElement('meta');
                    meta.setAttribute('name', 'turnstile-required');
                    document.head.appendChild(meta);
                }
                if (meta) meta.setAttribute('content', required ? '1' : '0');
                try {
                    document.cookie = 'dummyfiles_turnstile=' + (required ? '1' : '0') + '; path=/; Max-Age=3600; SameSite=Lax';
                } catch (e) {}
                if (!required) {
                    clearTurnstileToken();
                    hideTurnstileHost();
                }
