<script data-cookie-consent>
(function () {
    // Prevent anchor-based scroll while keeping the package's accordion logic intact.
    var modal = document.getElementById('cookies-policy');
    if (!modal) return;
    modal.querySelectorAll('a[href^="#"]').forEach(function (a) {
        var real = a.getAttribute('href');
        a.setAttribute('href', 'javascript:void(0)');
        a.getAttribute = function (name) {
            return name === 'href' ? real : Element.prototype.getAttribute.call(this, name);
        };
    });

    function setOptionalCategories(on) {
        modal.querySelectorAll('.cookies__category input[type="checkbox"]:not(:disabled)').forEach(function (cb) {
            cb.checked = on;
        });
    }

    function deleteAnalyticsCookies() {
        var domain = location.hostname.replace(/^www\./, '');
        var cookies = document.cookie.split(';').map(function (c) { return c.trim().split('=')[0]; });
        cookies.forEach(function (name) {
            if (!/^(_ga|_gid|_gat)/.test(name) && !/^_pk_/.test(name)) return;
            ['/', window.location.pathname].forEach(function (path) {
                [domain, '.' + domain, 'www.' + domain].forEach(function (d) {
                    document.cookie = name + '=; Max-Age=0; path=' + path + '; domain=' + d + ';';
                });
            });
        });
    }

    function wrapConsentApi() {
        var api = window.LaravelCookieConsent;
        if (!api || api.__cfgReloadWrapped) {
            return Boolean(api && api.__cfgReloadWrapped);
        }

        api.__cfgReloadWrapped = true;

        var acceptAll = api.acceptAll.bind(api);
        api.acceptAll = function () {
            return acceptAll().then(function () {
                window.location.reload();
            });
        };

        var acceptEssentials = api.acceptEssentials.bind(api);
        api.acceptEssentials = function () {
            return acceptEssentials().then(function () {
                deleteAnalyticsCookies();
                window.location.reload();
            });
        };

        var configure = api.configure.bind(api);
        api.configure = function (formData) {
            var categories = formData && formData.getAll ? formData.getAll('categories[]') : [];
            return configure(formData).then(function () {
                if (categories.indexOf('analytics') === -1) {
                    deleteAnalyticsCookies();
                }
                window.location.reload();
            });
        };

        return true;
    }

    var acceptAllForm = modal.querySelector('.cookiesBtn--accept');
    if (acceptAllForm) {
        acceptAllForm.addEventListener('submit', function () {
            setOptionalCategories(true);
        });
    }
    var acceptEssentialsForm = modal.querySelector('.cookiesBtn--essentials');
    if (acceptEssentialsForm) {
        acceptEssentialsForm.addEventListener('submit', function () {
            setOptionalCategories(false);
        });
    }

    if (!wrapConsentApi()) {
        window.addEventListener('load', wrapConsentApi);
    }
}());
</script>
<style data-cookie-consent>
    #cookies-policy.cookies{bottom:0;font-size:16px;max-height:100%;max-width:100%;overflow:auto;position:fixed;right:0;transition:transform .2s ease-out,opacity .2s ease-out;z-index:9999}#cookies-policy.cookies--closing{opacity:0;transform:translateY(10px)}#cookies-policy.cookies--show .cookies__btn--customize{border-bottom:1px solid #e7e8e9;border-top:none}#cookies-policy.cookies--show .cookies__btn svg{transform:rotate(180deg)}#cookies-policy.cookies--no-js .cookies__expandable:target,#cookies-policy.cookies--no-js .cookies__section .cookies__expandable{height:auto;opacity:1;transition:height .3s ease-out,opacity .3s ease-out;visibility:visible}#cookies-policy.cookies--no-js .cookies__details{display:none}#cookies-policy.cookies--no-js .cookies__sections{max-height:-moz-fit-content;max-height:fit-content}#cookies-policy.cookies--no-js svg{display:none}#cookies-policy .cookies__expandable{display:block;height:0;opacity:0;overflow:hidden;transition:height .3s ease-out,opacity .3s ease-out,visibility 0s linear .3s;visibility:hidden}#cookies-policy .cookies__expandable--open{height:auto;opacity:1;transition:height .3s ease-out,opacity .3s ease-out;visibility:visible}#cookies-policy .cookies__alert{background:#fff;border:1px solid #e7e8e9;border-radius:8px;box-shadow:0 12px 12px -8px rgba(0,0,0,.08),0 0 4px rgba(0,0,0,.04);margin:4%;max-height:90%;max-width:90%;width:22em}#cookies-policy .cookies__container{display:block;height:auto;opacity:1;overflow:hidden;transition:height .3s ease-out,opacity .3s ease-out,visibility 0s linear .1s;visibility:visible}#cookies-policy .cookies__container--hide{height:0;opacity:0;transition:height .3s ease-out,opacity .3s ease-out,visibility 0s linear .3s;visibility:hidden}#cookies-policy .cookies__wrapper{padding:1em 1.5em}#cookies-policy .cookies__title{color:#2c2e30;font-weight:700;line-height:1.4em;margin-bottom:.8em}#cookies-policy .cookies__intro{color:#2c2e30;font-size:.875em;font-weight:450;line-height:1.4em}#cookies-policy .cookies__intro p{margin-top:1em}#cookies-policy .cookies__intro p:first-child{margin-top:0}#cookies-policy .cookies__intro a{color:inherit;text-decoration:underline;transition:color .2s ease-out}#cookies-policy .cookies__intro a:focus,#cookies-policy .cookies__intro a:hover{color:#7959ef}#cookies-policy .cookies__actions{display:flex;flex-direction:column;gap:4px;justify-content:space-between;margin-top:1em}#cookies-policy .cookies__btn--customize{align-items:center;border-top:1px solid #e7e8e9;color:#2c2e30;display:flex;font-size:.875em;font-weight:600;justify-content:space-between;line-height:1em;padding:1.125em 24px;position:relative;text-decoration:none}#cookies-policy .cookies__btn svg{transition:transform .2s ease-out}#cookies-policy .cookies__sections{max-height:450px;overflow-y:scroll}#cookies-policy .cookies__section{padding:0 1.5em}#cookies-policy .cookies__section+.cookies__section{border-top:1px solid #eee}#cookies-policy .cookies__box,#cookies-policy .cookies__category{display:block;overflow:hidden;position:relative}#cookies-policy .cookies__category input{display:block;margin:0;padding:0;position:absolute;right:105%;top:0}#cookies-policy .cookies__box{cursor:pointer;line-height:1.4em;padding:1em 3em 1em 0}#cookies-policy .cookies__box:after,#cookies-policy .cookies__box:before{border-radius:1.4em;content:"";display:block;position:absolute;top:50%}#cookies-policy .cookies__box:after{background:#e7e8e9;height:1.4em;margin-top:-.7em;right:0;transition:background .2s ease-out,opacity .2s ease-out;width:2.5em;z-index:0}#cookies-policy .cookies__box:before{background:#fff;height:1em;margin-top:-.5em;right:.75em;transform:translateX(-.55em);transition:transform .2s ease-out;width:1em;z-index:1}#cookies-policy .cookies__category input:checked+.cookies__box:after{background:#7959ef;opacity:1}#cookies-policy .cookies__category input:disabled+.cookies__box:after{opacity:.6}#cookies-policy .cookies__category input:checked+.cookies__box:before{transform:translateX(.55em)}#cookies-policy .cookies__label{color:#2c2e30;font-size:.875em;font-weight:600}#cookies-policy .cookies__info{color:#2c2e30;font-size:.875em;font-weight:450;line-height:1.4em}#cookies-policy .cookies__details{color:#7959ef;display:block;font-size:.875em;margin:.625em 0 .9em;transition:color .2s ease-out}#cookies-policy .cookies__details:focus,#cookies-policy .cookies__details:hover{color:#7959ef}#cookies-policy .cookies__definitions{color:#676767;font-size:.875em;line-height:1.2em;padding-top:.8em}#cookies-policy .cookies__cookie+.cookies__cookie{margin-top:1em}#cookies-policy .cookies__name{color:#8a8e92;display:inline;font-weight:600;line-height:22px}#cookies-policy .cookies__duration{color:#8a8e92;display:inline;text-align:right}#cookies-policy .cookies__description{color:#8a8e92;display:block;line-height:120%;padding-top:.3em;text-align:left;width:100%}#cookies-policy .cookies__save{border-top:1px solid #e7e8e9;display:flex;justify-content:flex-end;margin-top:.4em;padding:.75em 1.5em}#cookies-policy .cookiesBtn{width:100%}#cookies-policy .cookiesBtn__link{background:#7959ef;border:1px solid #7959ef;border-radius:4px;color:#fff;cursor:pointer;display:block;font:inherit;font-size:14px;font-weight:600;line-height:1em;margin:0;overflow:hidden;padding:.86em 1em;text-align:center;text-decoration:none;text-overflow:ellipsis;transition:opacity .2s ease-out;white-space:nowrap;width:100%}#cookies-policy .cookiesBtn__link:focus,#cookies-policy .cookiesBtn__link:hover{opacity:.8}


    /* Theme overrides – loaded after package CSS for specificity */
    #cookies-policy.cookie-consent-theme .cookies__alert {
        background: var(--color-white, #fff);
        border: 1px solid var(--color-neutral-200, #e4e4e7);
        border-radius: 14px;
        box-shadow: 0 12px 24px -8px rgba(0,0,0,.1), 0 0 4px rgba(0,0,0,.04);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__alert,
    html.dark #cookies-policy.cookie-consent-theme .cookies__alert {
        background: var(--color-neutral-800, #27272a);
        border-color: var(--color-neutral-700, #3f3f46);
        box-shadow: 0 12px 24px -8px rgba(0,0,0,.3), 0 0 4px rgba(0,0,0,.2);
    }
    #cookies-policy.cookie-consent-theme .cookies__title { color: var(--color-neutral-900, #18181b); font-weight: 700; }
    .dark #cookies-policy.cookie-consent-theme .cookies__title { color: var(--color-neutral-50, #fafafa); }
    #cookies-policy.cookie-consent-theme .cookies__intro,
    #cookies-policy.cookie-consent-theme .cookies__intro p { color: var(--color-neutral-700, #3f3f46); }
    .dark #cookies-policy.cookie-consent-theme .cookies__intro,
    .dark #cookies-policy.cookie-consent-theme .cookies__intro p { color: var(--color-neutral-300, #d4d4d8); }
    #cookies-policy.cookie-consent-theme .cookies__intro a { color: var(--color-accent); text-decoration: none; }
    #cookies-policy.cookie-consent-theme .cookies__intro a:hover { text-decoration: underline; }

    /* Buttons – äußere Form erhält alle visuellen Styles */
    #cookies-policy.cookie-consent-theme .cookies__actions {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 1em;
    }
    #cookies-policy.cookie-consent-theme .cookiesBtn {
        display: block;
        width: 100%;
        border-radius: 10px;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        cursor: pointer;
    }
    /* Innerer Submit-Button: transparent, erbt alles vom Form-Container */
    #cookies-policy.cookie-consent-theme .cookiesBtn .cookiesBtn__link {
        all: unset !important;
        display: block !important;
        width: 100% !important;
        padding: .5rem 1rem !important;
        font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif !important;
        font-size: .875rem !important;
        font-weight: 500 !important;
        line-height: 1.4 !important;
        text-align: center !important;
        color: inherit !important;
        background: transparent !important;
        border: none !important;
        cursor: pointer !important;
        box-sizing: border-box !important;
        border-radius: 10px !important;
    }
    #cookies-policy.cookie-consent-theme .cookiesBtn--essentials {
        background: var(--color-neutral-100, #f4f4f5);
        color: var(--color-neutral-800, #27272a);
        border: 1px solid var(--color-neutral-200, #e4e4e7);
    }
    .dark #cookies-policy.cookie-consent-theme .cookiesBtn--essentials {
        background: var(--color-neutral-700, #3f3f46);
        color: var(--color-neutral-200, #e4e4e7);
        border-color: var(--color-neutral-600, #52525b);
    }
    #cookies-policy.cookie-consent-theme .cookiesBtn--essentials:hover,
    #cookies-policy.cookie-consent-theme .cookiesBtn--essentials:focus-within {
        background: var(--color-neutral-200, #e4e4e7);
    }
    .dark #cookies-policy.cookie-consent-theme .cookiesBtn--essentials:hover,
    .dark #cookies-policy.cookie-consent-theme .cookiesBtn--essentials:focus-within {
        background: var(--color-neutral-600, #52525b);
    }
    #cookies-policy.cookie-consent-theme .cookiesBtn--accept {
        background: var(--color-accent);
        color: var(--color-accent-foreground);
        border: 1px solid var(--color-accent);
    }
    #cookies-policy.cookie-consent-theme .cookiesBtn--accept:hover {
        opacity: .88;
    }

    /* Customize-Zeile */
    #cookies-policy.cookie-consent-theme .cookies__btn--customize {
        color: var(--color-neutral-800, #27272a);
        border-color: var(--color-neutral-200, #e4e4e7);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__btn--customize {
        color: var(--color-neutral-200, #e4e4e7);
        border-color: var(--color-neutral-700, #3f3f46);
    }
    #cookies-policy.cookie-consent-theme.cookies--show .cookies__btn--customize {
        border-bottom: 1px solid var(--color-neutral-200, #e4e4e7);
    }
    .dark #cookies-policy.cookie-consent-theme.cookies--show .cookies__btn--customize {
        border-bottom-color: var(--color-neutral-700, #3f3f46);
    }
    #cookies-policy.cookie-consent-theme .cookies__btn svg {
        color: var(--color-neutral-600, #52525b);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__btn svg {
        color: var(--color-neutral-400, #a1a1aa);
    }

    /* Anpassen: Intro + Accept-Buttons sichtbar lassen */
    #cookies-policy.cookie-consent-theme .cookies__container--hide {
        height: auto !important;
        opacity: 1 !important;
        visibility: visible !important;
        overflow: visible !important;
    }

    /* Sections & Toggle */
    #cookies-policy.cookie-consent-theme .cookies__section + .cookies__section {
        border-top-color: var(--color-neutral-200, #e4e4e7);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__section + .cookies__section {
        border-top-color: var(--color-neutral-700, #3f3f46);
    }
    #cookies-policy.cookie-consent-theme .cookies__category,
    #cookies-policy.cookie-consent-theme .cookies__box {
        overflow: visible;
    }
    /* Checkbox über den Schalter legen, sonst schluckt overflow:hidden die Klicks */
    #cookies-policy.cookie-consent-theme .cookies__category input[type="checkbox"] {
        position: absolute;
        right: 0;
        top: 50%;
        width: 2.5em;
        height: 1.4em;
        margin: -0.7em 0 0 0;
        padding: 0;
        opacity: 0;
        z-index: 3;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        display: block;
    }
    #cookies-policy.cookie-consent-theme .cookies__category input[type="checkbox"]:disabled {
        cursor: not-allowed;
    }
    #cookies-policy.cookie-consent-theme .cookies__box::after {
        background: var(--color-neutral-200, #e4e4e7);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__box::after {
        background: var(--color-neutral-600, #52525b);
    }
    #cookies-policy.cookie-consent-theme .cookies__category input:checked + .cookies__box::after {
        background: var(--color-accent);
        opacity: 1;
    }
    #cookies-policy.cookie-consent-theme .cookies__category input:checked + .cookies__box::before {
        transform: translateX(0.55em);
    }
    #cookies-policy.cookie-consent-theme .cookies__status {
        margin-left: 0.4em;
        font-size: 0.75em;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-accent);
    }
    /* Lange Infotexte ausblenden, sonst sieht man nur den gesperrten „Notwendige“-Schalter */
    #cookies-policy.cookie-consent-theme .cookies__info {
        display: none;
    }
    #cookies-policy.cookie-consent-theme .cookies__box {
        padding-top: 0.7em;
        padding-bottom: 0.7em;
    }
    #cookies-policy.cookie-consent-theme .cookies__label {
        color: var(--color-neutral-900, #18181b);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__label {
        color: var(--color-neutral-100, #f4f4f5);
    }
    #cookies-policy.cookie-consent-theme .cookies__info {
        color: var(--color-neutral-700, #3f3f46);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__info {
        color: var(--color-neutral-300, #d4d4d8);
    }
    #cookies-policy.cookie-consent-theme .cookies__details {
        color: var(--color-accent);
    }
    #cookies-policy.cookie-consent-theme .cookies__details:hover { text-decoration: underline; }
    #cookies-policy.cookie-consent-theme .cookies__definitions,
    #cookies-policy.cookie-consent-theme .cookies__name,
    #cookies-policy.cookie-consent-theme .cookies__duration,
    #cookies-policy.cookie-consent-theme .cookies__description {
        color: var(--color-neutral-500, #71717a);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__definitions,
    .dark #cookies-policy.cookie-consent-theme .cookies__name,
    .dark #cookies-policy.cookie-consent-theme .cookies__duration,
    .dark #cookies-policy.cookie-consent-theme .cookies__description {
        color: var(--color-neutral-400, #a1a1aa);
    }
    #cookies-policy.cookie-consent-theme .cookies__save {
        border-top-color: var(--color-neutral-200, #e4e4e7);
    }
    .dark #cookies-policy.cookie-consent-theme .cookies__save {
        border-top-color: var(--color-neutral-700, #3f3f46);
    }
</style>
